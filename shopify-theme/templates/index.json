    "manifesto": {
      "type": "manifesto",
      "settings": {
        "eyebrow": "The Hedonistas Creed",
        "headline_1": "Not A Spirit.",
        "headline_2": "A Ritual.",
        "subline": "Every bottle carries smoke, fire, and the hands of a maestro who learned from his grandfather. This is mezcal the way it was always meant to be.",
        "marquee_text": "SMOKE · FIRE · EARTH · TRADITION · WILD · PLEASURE · UNCOMPROMISED · OAXACA · MEZCAL ·",
        "quote_1": "The smoke doesn’t just flavour the mezcal. It becomes it.",
        "body_1": "Agave hearts roast for three days in earthen pits over volcanic river stone. The smoke penetrates every fibre, every sugar, every molecule — and carries the memory of that fire into every sip.",
        "quote_2": "The stone wheel has turned for centuries. We refuse to let it stop.",
        "body_2": "A two-tonne tahona — a volcanic millstone pulled by a horse — slowly crushes the roasted agave. It takes longer. It costs more. The result cannot be replicated by a mechanical shredder. So we keep turning the stone.",
        "quote_3": "This is the mezcal they make for themselves, not for us. We just get to drink it.",
        "body_3": "Our maestro learned the craft from his father, who learned it from his. Every decision — the wood of the fermentation vat, the clay of the still, the cut of the distillation — comes from generations of accumulated knowledge that cannot be taught in a school.",
        "closing_statement": "Pleasure, uncompromised.",
        "cta_label": "The Craft Behind Every Bottle"
      }
    },
