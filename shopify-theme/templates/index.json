    "manifesto": {
      "type": "manifesto",
      "settings": {
        "color_open": "#c65602",
        "eyebrow": "nuestro manifiesto",
        "text_eyebrow": "#1b1a19",
        "headline_1": "We Don't make mezcal.",
        "text_headline_1": "#f3e6d1",
        "headline_2": "we make moments you'll never forget",
        "text_headline_2": "#1b1a19",
        "subline": "Most brands chase the pour. We chase what comes next. //The stories, the laughter, the secrets, //and the friends you make along the way.",
        "text_subline": "#f3e6d1",
        "marquee_text": "go deep · go further · go big · go home · go together · go solo · go sideways · go early · go late · go all night · go hard · go gentle · go deep · go further · go big · go home · go together · go solo · go sideways · go early · go late · go all night · go hard · go gentle ·",
        "color_marquee_bg": "#dbb149",
        "color_marquee_text": "#1a1716",
        "marquee_speed": 44,
        "color_panel_1": "#09627a",
        "image_1": "shopify://shop_images/nightbar.png",
        "image_1_x": 50,
        "image_1_y": 50,
        "image_1_zoom": 0,
        "quote_1": "THE BEST NIGHTS DON’T END ON TIME. //sometimes they don't end at all.",
        "text_panel_1_quote": "#1b1a19",
        "body_1": "The phone goes down. //The story gets better. //The night becomes something //no one could have planned.",
        "text_panel_1_body": "#f3e6d1",
        "color_panel_2": "#af2e56",
        "image_2": "shopify://shop_images/jimadors.jpg",
        "image_2_x": 16,
        "image_2_y": 50,
        "image_2_zoom": 0,
        "quote_2": "Our mezcal takes time. //You should too.",
        "text_panel_2_quote": "#191a1d",
        "body_2": "No shortcuts. No spreadsheets. No algorithms. //Go Deep is not a line on a label. //It is an invitation, a challenge, //and a compass for a life lived fully.",
        "text_panel_2_body": "#f3e6d1",
        "color_panel_3": "#1a1716",
        "image_3": "shopify://shop_images/EUDAHedonistas-30.jpg",
        "panel_3_focal_x": 21,
        "finale_line_1": "Go Deep is both an invitation //and a challenge",
        "finale_line_2": "to enter doors //without expectations",
        "finale_line_3": "To discover laughter //that shakes your whole body",
        "finale_line_4": "And silence that speaks //more than words.",
        "finale_line_5": "In a world built for speed",
        "finale_line_6": "We suggest the scenic route",
        "finale_font_family": "pacifico",
        "finale_font_size": 6,
        "color_finale_regular": "#f3e6d1",
        "color_finale_bold": "#f3e6d1",
        "poem_finale_name": "Hedonistas Mezcal",
        "text_finale_name": "#dbb149",
        "poem_finale_call": "Go Deep.",
        "text_finale_call": "#dbb149",
        "cta_label": "The Craft Behind Every Bottle",
        "cta_url": ""
      }
    },
    "story": {
      "type": "story",
      "disabled": true,
      "settings": {
        "overlay_color": "",
        "story_label": "Nuestra Historia",
        "eyebrow_font": "metallophile",
        "eyebrow_size": 0.8,
        "story_heading": "Born from Obsession.",
        "heading_font": "display",
        "heading_size": 4.5,
        "intro": "",
        "intro_font": "metallophile",
        "intro_size": 1.4,
        "story_body": "<p>Hedonistas Mezcal began with two friends and a stubborn belief — that the finest mezcal in the world deserves to be shared. Not hoarded. Not gatekept. Shared.</p><p>Founded in the highlands of Oaxaca, we partnered with maestros mezcaleros whose families have cultivated and cooked agave the same way for generations. No shortcuts. No industrial process. Just fire, stone, time, and copper — and a friendship that wouldn't settle for less.</p>",
        "body_font": "metallophile",
        "body_size": 1.3,
        "quote": "\"The agave gives you everything. Your job is to not get in the way.\"",
        "quote_font": "metallophile",
        "quote_size": 1.4,
        "quote_italic": false,
        "story_image": "shopify://shop_images/24DF3EF8-D374-4F1A-A686-2821E7FAF529.jpg",
        "image_x": 50,
        "image_y": 50
      }
    },
