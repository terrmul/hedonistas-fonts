            "spec_3": "ABV: 48%",
            "nose": "Mango, roasted agave, wet stone, cacao",
            "palate": "Tropical fruit, baking spice, citrus oil, deep smoke",
            "body": "Full bodied, rich, layered",
            "finish": "Long, warming, lingering",
            "desc_body": "A prized wild agave that takes over a decade to mature. Smoke-forward and unmistakably complex — a finish that stays with you long after the glass is empty.",
            "pair_cocktails": "Best enjoyed neat — or a whisper of mineral water",
            "pair_food": "Dark chocolate, mole negro, aged cheese, toasted nuts",
            "pair_body": "Tobalá rewards slow sipping. Pair it with rich, savory flavors that echo its depth rather than compete with it.",
