    "maestro": {
      "type": "maestro",
      "settings": {
        "portrait": "shopify://shop_images/Kain_1.jpg",
        "focus_x": 36,
        "focus_y": 31,
        "label": "El Maestro Mezcalero",
        "heading": "The Hands Behind Every Drop.",
        "maestro_name": "Gerardo \"Kain\" Santiago Hernandez",
        "body": "<p>\"I learned mezcal the way most of us do in Oaxaca - alongside family, watching every step, year after year, as my son does today. We honor 500 years of Zapotec tradition and the generations of my family before me. With my team of jimadores, we seek perfection in every batch using just two ingredients, agave and water. The details matter: ripeness of the agave, hard wood for fuel, timing of the roast, fermentation pace, and cuts from the still. If the balance is not right, it does not go in the bottle.\" </p>"
      }
    },
