<!-- HERO — flat Raspberry, halftone dots, logo centrepiece -->
<section class="hero" id="hero">
  {%- if section.blocks.size > 0 -%}
    <div class="hero-video-carousel" id="hero-video-carousel">
      {%- for block in section.blocks -%}
        {%- if block.settings.video != blank -%}
          <video class="hero-video-bg{% if forloop.first %} is-active{% endif %}" muted playsinline preload="none" data-autoload{% if section.blocks.size == 1 %} loop{% endif %}{% if section.settings.poster_image != blank %} poster="{{ section.settings.poster_image | image_url: width: 1600 }}"{% endif %} {{ block.shopify_attributes }}>
            {%- for source in block.settings.video.sources -%}
              <source data-src="{{ source.url }}" type="{{ source.mime_type }}">
            {%- endfor -%}
          </video>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- else -%}
    <div class="hero-dots"></div>
  {%- endif -%}
  <div class="hero-back" id="hero-back">{{ section.settings.backdrop_word | escape }}</div>
  <div class="hero-mid" id="hero-mid">
    <div class="hero-brand">
      {%- assign logo_size = section.settings.logo_size | default: 180 -%}
      {%- if section.settings.logo != blank -%}
        <img class="hero-logo" src="{{ section.settings.logo | image_url: width: 360 }}" alt="{{ section.settings.logo_alt | escape }}" fetchpriority="high" decoding="async" style="height:{{ logo_size }}px;width:auto">
      {%- else -%}
        <img class="hero-logo" src="{{ 'icon.png' | asset_url }}" alt="{{ section.settings.logo_alt | escape }}" fetchpriority="high" decoding="async" style="height:{{ logo_size }}px;width:auto">
      {%- endif -%}
      <h1 class="hero-h1"><span class="split">{{ section.settings.heading_1 | escape | replace: '//', '<br>' }}</span><span class="split">{{ section.settings.heading_2 | escape | replace: '//', '<br>' }}</span></h1>
    </div>
  </div>

  {%- comment -%} Award badge — image PNG if provided, otherwise the styled text badge {%- endcomment -%}
  {%- if section.settings.badge_image != blank -%}
    <a class="hero-badge hero-badge--image" href="{{ section.settings.badge_link }}" aria-label="{{ section.settings.badge_aria | escape }}" style="width:{{ section.settings.badge_image_size }}px">
      <img src="{{ section.settings.badge_image | image_url: width: 600 }}" alt="{{ section.settings.badge_aria | escape }}" decoding="async" loading="lazy">
    </a>
  {%- else -%}
    {%- liquid
      assign ff_top = '"metallophile-sp8", sans-serif'
      if section.settings.badge_top_font == 'display'
        assign ff_top = "'Pacifico', serif"
      elsif section.settings.badge_top_font == 'system'
        assign ff_top = '-apple-system, "Helvetica Neue", Arial, sans-serif'
      endif
      assign ff_medal = '"metallophile-sp8", sans-serif'
      if section.settings.badge_medal_font == 'display'
        assign ff_medal = "'Pacifico', serif"
      elsif section.settings.badge_medal_font == 'system'
        assign ff_medal = '-apple-system, "Helvetica Neue", Arial, sans-serif'
      endif
      assign ff_year = '"metallophile-sp8", sans-serif'
      if section.settings.badge_year_font == 'display'
        assign ff_year = "'Pacifico', serif"
      elsif section.settings.badge_year_font == 'system'
        assign ff_year = '-apple-system, "Helvetica Neue", Arial, sans-serif'
      endif
      assign ff_body = '"metallophile-sp8", sans-serif'
      if section.settings.badge_body_font == 'display'
        assign ff_body = "'Pacifico', serif"
      elsif section.settings.badge_body_font == 'system'
        assign ff_body = '-apple-system, "Helvetica Neue", Arial, sans-serif'
      endif
    -%}
    <a class="hero-badge" href="{{ section.settings.badge_link }}" aria-label="{{ section.settings.badge_aria | escape }}">
      <span class="hero-badge-top" style="font-family:{{ ff_top }};font-size:{{ section.settings.badge_top_size }}rem;color:{{ section.settings.badge_top_color }}">{{ section.settings.badge_top | escape }}</span>
      <span class="hero-badge-medal" style="font-family:{{ ff_medal }};font-size:{{ section.settings.badge_medal_size }}rem;color:{{ section.settings.badge_medal_color }}">{{ section.settings.badge_medal | escape }}</span>
      <span class="hero-badge-year" style="font-family:{{ ff_year }};font-size:{{ section.settings.badge_year_size }}rem;color:{{ section.settings.badge_year_color }}">{{ section.settings.badge_year | escape }}</span>
      <span class="hero-badge-body" style="font-family:{{ ff_body }};font-size:{{ section.settings.badge_body_size }}rem;color:{{ section.settings.badge_body_color }}">{{ section.settings.badge_body | escape | replace: '//', '<br>' }}</span>
    </a>
  {%- endif -%}

  <div class="hero-fore" id="hero-fore">
    <p class="hero-tagline">{{ section.settings.tagline | escape | replace: '//', '<br>' }}</p>
    <div class="hero-locale">
      <p>{{ section.settings.locale | escape | replace: '//', '<br>' }}</p>
      <span class="hero-cue label">{{ section.settings.scroll_cue | escape }}</span>
    </div>
  </div>
</section>

{% style %}
  /* Image badge: strip the circular text-badge chrome and just show the PNG. */
  .hero-badge--image{
    aspect-ratio: auto !important; border: 0 !important; box-shadow: none !important;
    background: none !important; -webkit-backdrop-filter: none !important; backdrop-filter: none !important;
    padding: 0 !important; border-radius: 0 !important; min-width: 0 !important; max-width: 45vw;
  }
  .hero-badge--image img{ width: 100%; height: auto; display: block; }

  /* Mobile: shrink the award badge and tuck it into the top-right corner so it
     doesn't crowd the central logo. */
  @media (max-width: 680px){
    .hero-badge{
      top: clamp(4.5rem, 9vh, 6.5rem);
      right: .9rem;
      min-width: 70px;
      max-width: 106px;
      padding: .75rem;
    }
    .hero-badge--image{ width: clamp(70px, 24vw, 118px) !important; max-width: 45vw; padding: 0 !important; }
    .hero-badge-top,
    .hero-badge-body{ font-size: .55rem !important; letter-spacing: .12em; }
    .hero-badge-medal{ font-size: .82rem !important; margin: .2rem 0 .28rem; }
    .hero-badge-year{ font-size: .58rem !important; letter-spacing: .12em; margin-bottom: .2rem; }
    .hero-badge-body{ max-width: 14ch; }
  }

  /* Landscape phones / short viewports: the logo is sized inline (height in px)
     so it stays huge in a short viewport. Scale it down to fit (overriding the
     inline height), tighten the headline, and drop the badge BELOW the nav bar
     so it clears the hamburger. */
  @media (orientation: landscape) and (max-height: 600px){
    .hero{ padding-bottom: 1.5rem; }
    .hero-brand{ transform: none; }
    .hero-logo{
      height: clamp(80px, 26vh, 140px) !important;
      margin-top: 0; margin-bottom: .8rem;
    }
    .hero-mid h1{ font-size: clamp(2rem, 11vh, 4.5rem); }
    .hero-badge{
      top: clamp(4.5rem, 13vh, 6rem); right: .8rem;
      min-width: 60px; max-width: 90px; padding: .6rem;
      animation-delay: .6s;
    }
    .hero-badge--image{ width: clamp(60px, 16vh, 100px) !important; max-width: 40vw; padding: 0 !important; }
    .hero-badge-top,
    .hero-badge-body{ font-size: .5rem !important; letter-spacing: .08em; }
    .hero-badge-medal{ font-size: .74rem !important; margin: .12rem 0 .18rem; }
    .hero-badge-year{ font-size: .5rem !important; letter-spacing: .08em; margin-bottom: .12rem; }
    .hero-badge-body{ max-width: 12ch; }
    .hero-tagline{ font-size: .82rem; line-height: 1.5; }
    .hero-locale p{ font-size: clamp(1rem, 4.5vh, 1.7rem); }
    .hero-cue{ margin-top: .5rem; }
  }
{% endstyle %}

<script>
(function(){
  /* Load the heavy background video AFTER the page is interactive so it never
     blocks first paint. The poster image shows immediately. */
  function loadHeroVideos(){
    var vids = document.querySelectorAll('.hero-video-bg[data-autoload]');
    if(!vids.length) return;
    vids.forEach(function(v){
      v.querySelectorAll('source[data-src]').forEach(function(s){
        if(!s.src) s.src = s.getAttribute('data-src');
      });
      try{ v.load(); }catch(e){}
      if(v.classList.contains('is-active')){
        var p = v.play(); if(p && p.catch) p.catch(function(){});
      }
    });
  }
  function schedule(){
    if('requestIdleCallback' in window){ requestIdleCallback(loadHeroVideos, { timeout: 2500 }); }
    else { setTimeout(loadHeroVideos, 800); }
  }
  if(document.readyState === 'complete'){ schedule(); }
  else { window.addEventListener('load', schedule); }
})();
</script>

{%- if section.blocks.size > 1 -%}
<script>
(function(){
  var carousel = document.getElementById('hero-video-carousel');
  if(!carousel) return;
  var videos = Array.from(carousel.querySelectorAll('.hero-video-bg'));
  if(videos.length < 2) return;
  var current = 0;
  function showNext(){
    videos[current].classList.remove('is-active');
    current = (current + 1) % videos.length;
    var nxt = videos[current];
    try{ nxt.currentTime = 0; }catch(e){}
    var p = nxt.play(); if(p && p.catch) p.catch(function(){});
    nxt.classList.add('is-active');
  }
  videos.forEach(function(v){ v.addEventListener('ended', showNext); });
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "header", "content": "Brand" },
    { "type": "image_picker", "id": "logo", "label": "Logo (cream / inverted PNG)" },
    { "type": "text", "id": "logo_alt", "label": "Logo alt text", "default": "Hedonistas Mezcal" },
    { "type": "range", "id": "logo_size", "label": "Logo size", "min": 60, "max": 600, "step": 10, "unit": "px", "default": 180 },
    { "type": "text", "id": "backdrop_word", "label": "Oversized backdrop word", "default": "Hedonistas" },
    { "type": "header", "content": "Background video" },
    { "type": "image_picker", "id": "poster_image", "label": "Video poster (still frame shown while the video loads)", "info": "Strongly recommended for speed — a single still image instead of a blank hero while the video downloads." },

    { "type": "header", "content": "Award Badge — image (optional)" },
    { "type": "paragraph", "content": "Add a badge PNG to replace the text badge entirely. Leave empty to use the styled text badge below." },
    { "type": "image_picker", "id": "badge_image", "label": "Badge image (PNG)" },
    { "type": "range", "id": "badge_image_size", "label": "Badge image size", "min": 60, "max": 320, "step": 5, "unit": "px", "default": 140 },

    { "type": "header", "content": "Award Badge — text" },
    { "type": "url", "id": "badge_link", "label": "Badge link" },
    { "type": "text", "id": "badge_aria", "label": "Badge screen-reader label", "default": "Winner of Four Golds, 2026, SF World Spirits Competition" },

    { "type": "header", "content": "Badge · Line 1 (lead-in)" },
    { "type": "text", "id": "badge_top", "label": "Text", "default": "Winner of" },
    { "type": "select", "id": "badge_top_font", "label": "Font", "default": "sans", "options": [ { "value": "sans", "label": "Metallophile (brand sans)" }, { "value": "display", "label": "Pacifico (display)" }, { "value": "system", "label": "System sans" } ] },
    { "type": "range", "id": "badge_top_size", "label": "Font size", "min": 0.4, "max": 2, "step": 0.1, "unit": "rem", "default": 0.8 },
    { "type": "color", "id": "badge_top_color", "label": "Color", "default": "#F3E6D1" },

    { "type": "header", "content": "Badge · Line 2 (award)" },
    { "type": "text", "id": "badge_medal", "label": "Text", "default": "Four Golds" },
    { "type": "select", "id": "badge_medal_font", "label": "Font", "default": "display", "options": [ { "value": "display", "label": "Pacifico (display)" }, { "value": "sans", "label": "Metallophile (brand sans)" }, { "value": "system", "label": "System sans" } ] },
    { "type": "range", "id": "badge_medal_size", "label": "Font size", "min": 0.6, "max": 3, "step": 0.1, "unit": "rem", "default": 1.3 },
    { "type": "color", "id": "badge_medal_color", "label": "Color", "default": "#DBB149" },

    { "type": "header", "content": "Badge · Line 3 (year)" },
    { "type": "text", "id": "badge_year", "label": "Text", "default": "2026" },
    { "type": "select", "id": "badge_year_font", "label": "Font", "default": "sans", "options": [ { "value": "sans", "label": "Metallophile (brand sans)" }, { "value": "display", "label": "Pacifico (display)" }, { "value": "system", "label": "System sans" } ] },
    { "type": "range", "id": "badge_year_size", "label": "Font size", "min": 0.4, "max": 2, "step": 0.1, "unit": "rem", "default": 0.7 },
    { "type": "color", "id": "badge_year_color", "label": "Color", "default": "#F3E6D1" },

    { "type": "header", "content": "Badge · Line 4 (competition, use // for a line break)" },
    { "type": "text", "id": "badge_body", "label": "Text", "default": "SF World Spirits" },
    { "type": "select", "id": "badge_body_font", "label": "Font", "default": "sans", "options": [ { "value": "sans", "label": "Metallophile (brand sans)" }, { "value": "display", "label": "Pacifico (display)" }, { "value": "system", "label": "System sans" } ] },
    { "type": "range", "id": "badge_body_size", "label": "Font size", "min": 0.4, "max": 2, "step": 0.1, "unit": "rem", "default": 0.8 },
    { "type": "color", "id": "badge_body_color", "label": "Color", "default": "#F3E6D1" },

    { "type": "header", "content": "Foreground (use // for a line break)" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "We are purveyors of the unforgettable. Late nights. Bold pours. No spectators." },
    { "type": "text", "id": "locale", "label": "Locale", "default": "Hecho en Oaxaca" },
    { "type": "text", "id": "scroll_cue", "label": "Scroll cue", "default": "Scroll ↓" }
  ],
  "blocks": [
    {
      "type": "video_slide",
      "name": "Background video",
      "settings": [
        { "type": "video", "id": "video", "label": "Video" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
