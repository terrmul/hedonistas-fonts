<!-- GO DEEP / SOCIAL + NEWSLETTER -->
<style>
  /* Remove the cream fade/blend on the edges of the Instagram strip */
  .deep-social .ig-track-outer::before,
  .deep-social .ig-track-outer::after { display:none !important; }

  /* GO DEEP header: eyebrow + heading + handle, vertically centered in its space, left-aligned */
  .deep-social .deep-head{
    display:flex; flex-direction:column; justify-content:center; align-items:flex-start;
    min-height:36vh; padding:0 3.5rem !important;
  }
  .deep-social .deep-panel-left{ flex-direction:column; align-items:flex-start; gap:1.2rem; }
  .deep-social .deep-head-text{ display:flex; flex-direction:column; align-items:flex-start; gap:.5rem; }
  .deep-social .deep-head-text .label{ margin:0; }

  /* Instagram strip + newsletter spacing */
  .deep-social .ig-track-outer{ padding:1.25rem 0 2.5rem !important; }
  .deep-social .deep-newsletter{
    display:flex; flex-direction:column; align-items:flex-start; gap:1.25rem;
    padding:1rem 3.5rem 4rem;
  }
  .deep-social .deep-newsletter h2{
    font-size:clamp(2rem,4vw,3.4rem); color:var(--ink); line-height:.9; margin:0;
  }

  /* Email field: don't stretch (keeps text vertically centered) */
  .deep-social .deep-form{ align-items:center !important; }
  .deep-social .deep-form input{
    height:3.4rem !important; line-height:3.4rem !important;
    padding-top:0 !important; padding-bottom:0 !important; box-sizing:border-box;
  }
  .deep-social .deep-form button{
    height:3.4rem !important; min-height:0 !important; box-sizing:border-box;
    display:inline-flex; align-items:center; justify-content:center;
  }

  /* Mobile: stack full-width, natural height */
  @media(max-width:900px){
    .deep-social { overflow-x:hidden; }
    .deep-social .deep-head{
      min-height:auto; flex-direction:column; align-items:stretch; gap:1.5rem; padding:2.5rem 1.25rem 1.5rem !important;
    }
    .deep-social .deep-panel{
      width:100%; max-width:100%; flex-direction:column; align-items:flex-start; gap:1rem;
    }
    .deep-social .deep-word-h2{ font-size:clamp(2.2rem,12vw,3rem); }
    .deep-social .handle{
      white-space:normal; overflow-wrap:anywhere;
      font-size:.72rem; letter-spacing:.16em; max-width:100%;
    }
    .deep-social .deep-newsletter{ padding:0 1.25rem 3.5rem; width:100%; }
    .deep-social .deep-newsletter h2{ font-size:clamp(1.8rem,9vw,2.6rem); }
    .deep-social .deep-form{ flex-direction:column; width:100%; }
    .deep-social .deep-form input{
      width:100%; border-right:1.5px solid rgba(26,23,22,.4);
    }
    .deep-social .deep-form button{ width:100%; }
  }
</style>
<section class="deep-social" data-nav="light" data-bg="bg-cream" style="background:{{ section.settings.section_bg }}">
  <div class="deep-head">
    <!-- Instagram identity -->
    <div class="deep-panel deep-panel-left reveal">
      <div class="deep-head-text">
        {%- if section.settings.eyebrow_label != blank -%}
          <div class="label" style="color:{{ section.settings.eyebrow_color }}">{{ section.settings.eyebrow_label | escape }}</div>
        {%- endif -%}
        <h2 class="deep-word-h2"><span>g</span><span>o</span><span class="sp"> </span><span>d</span><span>e</span><span>e</span><span>p</span><span>.</span></h2>
      </div>
      <a class="handle" href="{{ section.settings.instagram_url }}" aria-label="Hedonistas on Instagram">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        {{ section.settings.instagram_handle | escape }}
      </a>
    </div>
  </div>
  <div class="ig-track-outer">
    <div data-behold-id="rmloD6PyZAAVIsB6Rp5L"></div>
    <script>
      (function() {
        const d=document,s=d.createElement("script");s.type="module";
        s.src="https://w.behold.so/widget.js";d.head.append(s);
      })();
    </script>
  </div>
  <!-- Newsletter sign-up (below the images, left-aligned) -->
  <div class="deep-newsletter reveal">
    <h2>{{ section.settings.newsletter_heading | escape }}</h2>
    {%- if section.settings.newsletter_url != blank -%}
      <form class="deep-form" action="{{ section.settings.newsletter_url }}" method="post" target="_blank">
        <input type="email" name="email" placeholder="{{ section.settings.newsletter_placeholder | escape }}" aria-label="Email address" autocomplete="email"><button type="submit">{{ section.settings.newsletter_button | escape }}</button>
      </form>
    {%- else -%}
      {%- form 'customer' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="deep-form">
          <input type="email" name="contact[email]" placeholder="{{ section.settings.newsletter_placeholder | escape }}" aria-label="Email address" autocomplete="email"><button type="submit">{{ section.settings.newsletter_button | escape }}</button>
        </div>
      {%- endform -%}
    {%- endif -%}
  </div>
</section>
</main>

{% schema %}
{
  "name": "Social + Newsletter",
  "settings": [
    { "type": "header", "content": "Section" },
    { "type": "color", "id": "section_bg", "label": "Background color", "default": "#F3E6D1" },
    { "type": "header", "content": "Instagram" },
    { "type": "text", "id": "eyebrow_label", "label": "Eyebrow label", "default": "Follow The Ritual" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow color", "default": "#7C3A09" },
    { "type": "text", "id": "instagram_handle", "label": "Handle", "default": "@hedonistasdelafe" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "header", "content": "Newsletter" },
    { "type": "text", "id": "newsletter_heading", "label": "Heading", "default": "Go Deeper." },
    { "type": "text", "id": "newsletter_placeholder", "label": "Input placeholder", "default": "Your email address" },
    { "type": "text", "id": "newsletter_button", "label": "Button label", "default": "Subscribe" },
    { "type": "url", "id": "newsletter_url", "label": "External form action (Klaviyo/Mailchimp)", "info": "Leave blank to use Shopify's built-in customer signup." }
  ],
  "presets": [
    { "name": "Social + Newsletter" }
  ]
}
{% endschema %}