<!-- GO DEEP / SOCIAL + NEWSLETTER -->
<style>
  /* Remove the cream fade/blend on the edges of the Instagram strip */
  .deep-social .ig-track-outer::before,
  .deep-social .ig-track-outer::after { display:none !important; }

  /* GO DEEP header: match the other section headers (eyebrow + heading, same size/indent) */
  .deep-social .deep-head{
    display:block; min-height:auto !important;
    padding:3.5rem 4.5rem 2.2rem !important;
  }
  .deep-social .deep-panel-left{ flex-direction:column; align-items:flex-start; gap:1.1rem; width:auto; }
  .deep-social .deep-head-text{ display:flex; flex-direction:column; align-items:flex-start; }
  .deep-social .deep-head-text .label{ margin:0 0 .8rem; }
  .deep-social .deep-word-h2{ font-size:clamp(2.5rem,6vw,5rem) !important; line-height:.9; }
  /* keep the trailing period tight to the P (it gets tucked in via JS) */
  .deep-social .deep-word-h2 span:last-child{ display:inline-block; }

  /* Instagram strip + newsletter spacing */
  .deep-social .ig-track-outer{ padding:1.25rem 0 2.5rem !important; }
  .deep-social .deep-newsletter{
    display:flex; flex-direction:column; align-items:flex-start; gap:1.25rem;
    padding:1.5rem 4.5rem 4rem;
  }
  .deep-social .deep-newsletter h2{
    font-size:clamp(2.5rem,6vw,5rem); color:var(--ink); line-height:.9; margin:0;
  }

  /* Email field: don't stretch (keeps text vertically centered) */
  .deep-social .deep-form{ align-items:center !important; }
  .deep-social .deep-form input{
    height:3.4rem !important; line-height:3.4rem !important;
    padding-top:0 !important; padding-bottom:0 !important; box-sizing:border-box;
  }
  .deep-social .deep-form button{
    height:3.4rem !important; min-height:0 !important; box-sizing:border-box;
    display:inline-flex; align-items:center; justify-content:center;
  }
  .deep-social .deep-form button[disabled]{ opacity:.6; cursor:default; }

  /* Subscribe confirmation / error message */
  .deep-social .deep-form-msg{
    font-family:"metallophile-sp8",sans-serif; font-size:.95rem; line-height:1.4;
    margin:0; letter-spacing:.02em;
  }

  /* Mobile: stack full-width, natural height */
  @media(max-width:900px){
    .deep-social { overflow-x:hidden; }
    .deep-social .deep-head{
      padding:2.5rem 1.5rem 1.5rem !important;
    }
    .deep-social .deep-panel{
      width:100%; max-width:100%; flex-direction:column; align-items:flex-start; gap:1rem;
    }
    .deep-social .deep-word-h2{ font-size:clamp(2.2rem,12vw,3rem) !important; }
    .deep-social .handle{
      white-space:normal; overflow-wrap:anywhere;
      font-size:.72rem; letter-spacing:.16em; max-width:100%;
    }
    .deep-social .deep-newsletter{ padding:0 1.5rem 3.5rem; width:100%; }
    .deep-social .deep-newsletter h2{ font-size:clamp(1.8rem,9vw,2.6rem); }
    .deep-social .deep-form{ flex-direction:column; width:100%; }
    .deep-social .deep-form input{
      width:100%; border-right:1.5px solid rgba(26,23,22,.4);
    }
    .deep-social .deep-form button{ width:100%; }
  }
</style>
<section class="deep-social" data-nav="light" data-bg="bg-cream" style="background:{{ section.settings.section_bg }}">
  <div class="deep-head">
    <!-- Instagram identity -->
    <div class="deep-panel deep-panel-left reveal">
      <div class="deep-head-text">
        {%- if section.settings.eyebrow_label != blank -%}
          <div class="label" style="color:{{ section.settings.eyebrow_color }}">{{ section.settings.eyebrow_label | escape }}</div>
        {%- endif -%}
        <h2 class="deep-word-h2"><span>g</span><span>o</span><span class="sp"> </span><span>d</span><span>e</span><span>e</span><span>p</span><span>.</span></h2>
      </div>
      <a class="handle" href="{{ section.settings.instagram_url }}" aria-label="Hedonistas on Instagram">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        {{ section.settings.instagram_handle | escape }}
      </a>
    </div>
  </div>
  <div class="ig-track-outer">
    <div data-behold-id="rmloD6PyZAAVIsB6Rp5L"></div>
    <script>
      /* Lazy-load the Behold Instagram widget only when this section nears the
         viewport, so it doesn't add requests/weight to the initial page load. */
      (function(){
        var holder = document.querySelector('.deep-social .ig-track-outer');
        if(!holder) return;
        var loaded = false;
        function loadBehold(){
          if(loaded) return; loaded = true;
          var s = document.createElement('script');
          s.type = 'module';
          s.src = 'https://w.behold.so/widget.js';
          document.head.appendChild(s);
        }
        if('IntersectionObserver' in window){
          var io = new IntersectionObserver(function(entries){
            entries.forEach(function(e){ if(e.isIntersecting){ loadBehold(); io.disconnect(); } });
          }, { rootMargin: '400px' });
          io.observe(holder);
        } else {
          loadBehold();
        }
      })();
    </script>
  </div>
  <!-- Newsletter sign-up (below the images, left-aligned) -->
  <div class="deep-newsletter reveal">
    <h2>{{ section.settings.newsletter_heading | escape }}</h2>
    {%- if section.settings.klaviyo_public_key != blank and section.settings.klaviyo_list_id != blank -%}
      <form class="deep-form" id="klaviyo-subscribe" novalidate
        data-company="{{ section.settings.klaviyo_public_key | escape }}"
        data-list="{{ section.settings.klaviyo_list_id | escape }}"
        data-success="{{ section.settings.newsletter_success | escape }}">
        <input type="email" name="email" required placeholder="{{ section.settings.newsletter_placeholder | escape }}" aria-label="Email address" autocomplete="email"><button type="submit">{{ section.settings.newsletter_button | escape }}</button>
      </form>
      <p class="deep-form-msg" id="klaviyo-msg" role="status" aria-live="polite" hidden></p>
      <script>
      (function(){
        var form = document.getElementById('klaviyo-subscribe');
        if(!form || form.dataset.bound) return;
        form.dataset.bound = '1';
        var msg = document.getElementById('klaviyo-msg');
        function show(text, ok){
          if(!msg) return;
          msg.textContent = text;
          msg.hidden = false;
          msg.style.color = ok ? 'var(--ink, #1a1716)' : 'var(--hibiscus, #AF2E56)';
        }
        form.addEventListener('submit', function(e){
          e.preventDefault();
          var input = form.querySelector('input[type=email]');
          var email = (input && input.value || '').trim();
          if(!email){ show('Please enter your email.', false); return; }
          var btn = form.querySelector('button');
          if(btn) btn.disabled = true;
          fetch('https://a.klaviyo.com/client/subscriptions/?company_id=' + encodeURIComponent(form.dataset.company), {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'revision': '2024-10-15' },
            body: JSON.stringify({
              data: {
                type: 'subscription',
                attributes: { profile: { data: { type: 'profile', attributes: { email: email } } } },
                relationships: { list: { data: { type: 'list', id: form.dataset.list } } }
              }
            })
          }).then(function(r){
            if(r.ok || r.status === 202){
              show(form.dataset.success || 'You’re subscribed.', true);
              form.reset();
            } else {
              show('Something went wrong — please try again.', false);
            }
          }).catch(function(){
            show('Something went wrong — please try again.', false);
          }).then(function(){
            if(btn) btn.disabled = false;
          });
        });
      })();
      </script>
    {%- elsif section.settings.newsletter_url != blank -%}
      <form class="deep-form" action="{{ section.settings.newsletter_url }}" method="post" target="_blank">
        <input type="email" name="email" placeholder="{{ section.settings.newsletter_placeholder | escape }}" aria-label="Email address" autocomplete="email"><button type="submit">{{ section.settings.newsletter_button | escape }}</button>
      </form>
    {%- else -%}
      {%- form 'customer' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="deep-form">
          <input type="email" name="contact[email]" placeholder="{{ section.settings.newsletter_placeholder | escape }}" aria-label="Email address" autocomplete="email"><button type="submit">{{ section.settings.newsletter_button | escape }}</button>
        </div>
      {%- endform -%}
    {%- endif -%}
  </div>
</section>

<script>
(function(){
  var h = document.querySelector('.deep-social .deep-word-h2');
  if(!h) return;
  var dot = h.querySelector('span:last-child');
  if(!dot || dot.textContent.replace(/\s/g,'') !== '.') return;
  function tuckDot(){
    dot.style.display = 'inline-block';
    dot.style.transform = 'none';
    dot.style.marginRight = '0';
    var w = dot.getBoundingClientRect().width;
    if(w){
      dot.style.transform = 'translateX(-' + w + 'px)';
      dot.style.marginRight = '-' + w + 'px';
    }
  }
  if(document.fonts && document.fonts.ready){ document.fonts.ready.then(tuckDot); } else { tuckDot(); }
  window.addEventListener('load', tuckDot);
  window.addEventListener('resize', function(){ clearTimeout(dot._rT); dot._rT = setTimeout(tuckDot, 150); }, { passive: true });
})();
</script>

{% schema %}
{
  "name": "Social + Newsletter",
  "settings": [
    { "type": "header", "content": "Section" },
    { "type": "color", "id": "section_bg", "label": "Background color", "default": "#F3E6D1" },
    { "type": "header", "content": "Instagram" },
    { "type": "text", "id": "eyebrow_label", "label": "Eyebrow label", "default": "Follow The Ritual" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow color", "default": "#7C3A09" },
    { "type": "text", "id": "instagram_handle", "label": "Handle", "default": "@hedonistasdelafe" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "header", "content": "Newsletter" },
    { "type": "text", "id": "newsletter_heading", "label": "Heading", "default": "Go Deeper." },
    { "type": "text", "id": "newsletter_placeholder", "label": "Input placeholder", "default": "Your email address" },
    { "type": "text", "id": "newsletter_button", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "newsletter_success", "label": "Success message", "default": "You’re subscribed. Welcome to the ritual." },
    { "type": "header", "content": "Klaviyo (recommended)" },
    { "type": "paragraph", "content": "Connects the form directly to a Klaviyo list. Both values are the public/safe ones from your Klaviyo account." },
    { "type": "text", "id": "klaviyo_public_key", "label": "Klaviyo Public API Key (Site ID)", "default": "WU5u94" },
    { "type": "text", "id": "klaviyo_list_id", "label": "Klaviyo List ID", "default": "VDmga8" },
    { "type": "header", "content": "Other provider (only if not using Klaviyo)" },
    { "type": "url", "id": "newsletter_url", "label": "External form action (Mailchimp/etc.)", "info": "Used only if the Klaviyo fields above are empty. Leave blank to fall back to Shopify's built-in signup." }
  ],
  "presets": [
    { "name": "Social + Newsletter" }
  ]
}
{% endschema %}
