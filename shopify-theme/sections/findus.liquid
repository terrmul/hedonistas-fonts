<!-- FIND US -->
{% style %}
  #findus .findus-head-left .label { color: {{ section.settings.color_label }} !important; }
  #findus .findus-head-left h2 { color: {{ section.settings.color_heading }} !important; }
  #findus .findus-head-right, #findus .findus-head-right p { color: {{ section.settings.color_intro }} !important; }
  #findus .findus-map { position: relative; }
  #findus .map-scroll-hint {
    position: absolute; top: 14px; right: 14px; z-index: 5;
    background: rgba(26,23,22,.72); color: #F3E6D1;
    font-family: "metallophile-sp8", sans-serif;
    font-size: .68rem; letter-spacing: .08em; text-transform: uppercase;
    padding: .45rem .7rem; border-radius: 4px; pointer-events: none;
    box-shadow: 0 2px 10px rgba(0,0,0,.25);
    transition: background .2s ease, color .2s ease;
  }
  #findus .map-scroll-hint.pulse {
    animation: mapHintJiggle .6s ease;
    background: #DBB149; color: #1a1716;
    box-shadow: 0 3px 16px rgba(219,177,73,.55);
  }
  @keyframes mapHintJiggle {
    0%,100% { transform: translateX(0) rotate(0); }
    12% { transform: translateX(-5px) rotate(-2deg) scale(1.06); }
    28% { transform: translateX(5px) rotate(2deg) scale(1.06); }
    44% { transform: translateX(-4px) rotate(-1.5deg); }
    60% { transform: translateX(4px) rotate(1.5deg); }
    76% { transform: translateX(-2px); }
    88% { transform: translateX(2px); }
  }
  @media (max-width: 920px) { #findus .map-scroll-hint { display: none !important; } }
  @media (prefers-reduced-motion: reduce) { #findus .map-scroll-hint.pulse { animation: none; } }
{% endstyle %}
<div class="findus" id="findus" data-nav="dark" data-bg="bg-cactus" style="background:{{ section.settings.color_section_bg }}">
  <div class="findus-head">
    <div class="findus-head-left">
      <div class="label">{{ section.settings.label | escape }}</div>
      <h2>{{ section.settings.heading | escape }}</h2>
    </div>
    <div class="findus-head-right">{{ section.settings.intro }}</div>
  </div>
  <div class="findus-map" id="findus-map">
    <stockist-store-locator data-stockist-widget-tag="{{ section.settings.stockist_tag }}" style="display:block;width:100%">
      Loading store locator from <a href="https://stockist.co">Stockist store locator</a>...
    </stockist-store-locator>
    <script async src="https://stockist.co/embed/v1/widget.min.js"></script>
  </div>
</div>
{% schema %}
{
  "name": "Find Us",
  "settings": [
    { "type": "text", "id": "label", "label": "Eyebrow label", "default": "Bars · Restaurants · Retail" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find Us" },
    { "type": "richtext", "id": "intro", "label": "Intro copy", "default": "<p>Every bar is a sanctuary where strangers become confidants and the bartender a Curandero. Find Hedonistas near you.</p>" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "color_section_bg", "label": "Section background", "default": "#286140" },
    { "type": "color", "id": "color_label", "label": "Eyebrow color", "default": "#DBB149" },
    { "type": "color", "id": "color_heading", "label": "Heading color", "default": "#F3E6D1" },
    { "type": "color", "id": "color_intro", "label": "Intro text color", "default": "#F3E6D1" },
    { "type": "text", "id": "stockist_tag", "label": "Stockist widget tag", "default": "map_93gwz2p3", "info": "From your Stockist dashboard." }
  ],
  "presets": [{ "name": "Find Us" }]
}
{% endschema %}