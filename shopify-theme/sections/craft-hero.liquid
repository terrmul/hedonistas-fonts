<!-- CRAFT PAGE HERO -->
<section class="craft-hero" id="la-tradicion" data-bg="bg-ink" data-overlay="{{ section.settings.overlay_color | default: '#5C3A22' }}">
  <div class="craft-hero-bg">
    {%- if section.settings.bg_image != blank -%}
      <img src="{{ section.settings.bg_image | image_url: width: 2000 }}" alt="" loading="eager" decoding="async">
      <div class="craft-hero-scrim"></div>
    {%- endif -%}
  </div>
  <div class="craft-hero-content">
    <div class="label craft-hero-eyebrow">{{ section.settings.eyebrow | escape | replace: '//', '<br>' }}</div>
    <h1 class="craft-hero-h1">{{ section.settings.headline | escape | replace: '//', '<br>' }}</h1>
    <p class="craft-hero-sub">{{ section.settings.subline | replace: '//', '<br>' }}</p>
    <a class="mag-btn mag-cream craft-hero-cta" href="#craft">{{ section.settings.scroll_label | escape | replace: '//', '<br>' }}</a>
  </div>
</section>

{% style %}
  /* transparent so the scroll-colour overlay shows through (no gradient) */
  .craft-hero{ background: transparent !important; }
{% endstyle %}

{% schema %}
{
  "name": "Craft Hero",
  "settings": [
    { "type": "color", "id": "overlay_color", "label": "Section background color", "info": "Scroll-blend color for this section. Leave empty for #5C3A22." },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "header", "content": "Text (use // for a line break)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "La Tradición" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Made By Hand. As It Always Was." },
    { "type": "inline_richtext", "id": "subline", "label": "Subline", "default": "Five steps. Zero shortcuts. The same process, unchanged, for generations." },
    { "type": "text", "id": "scroll_label", "label": "Scroll CTA", "default": "↓ The Process" }
  ],
  "presets": [{ "name": "Craft Hero" }]
}
{% endschema %}
