<footer>
  <div class="f-top">
    <div class="f-brand">
      <div class="f-logo">
        {%- if section.settings.brand_logo != blank -%}
          <img src="{{ section.settings.brand_logo | image_url: width: 64 }}" alt="{{ section.settings.brand_name | escape }}" loading="lazy" decoding="async" width="32" height="32">
        {%- else -%}
          <img src="{{ 'icon.png' | asset_url }}" alt="{{ section.settings.brand_name | escape }}" loading="lazy" decoding="async" width="32" height="32">
        {%- endif -%}
        {{ section.settings.brand_name | escape }}
      </div>
      <p class="f-blurb">{{ section.settings.blurb | escape | replace: '//', '<br>' }}</p>
      <div class="f-social">
        {%- for i in (1..6) -%}
          {%- assign pkey = 'social_' | append: i | append: '_platform' -%}
          {%- assign ukey = 'social_' | append: i | append: '_url' -%}
          {%- assign platform = section.settings[pkey] -%}
          {%- assign url = section.settings[ukey] -%}
          {%- if platform != 'none' and url != blank -%}
            <a href="{{ url }}" aria-label="{{ platform }}">
              {%- case platform -%}
                {%- when 'instagram' -%}{{ social_svg_instagram }}
                {%- when 'tiktok' -%}{{ social_svg_tiktok }}
                {%- when 'facebook' -%}{{ social_svg_facebook }}
                {%- when 'x' -%}{{ social_svg_x }}
                {%- when 'youtube' -%}{{ social_svg_youtube }}
                {%- when 'linkedin' -%}{{ social_svg_linkedin }}
                {%- else -%}{{ social_svg_website }}
              {%- endcase -%}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
    <div class="f-cols">
      {%- for c in (1..4) -%}
        {%- assign hkey = 'col_' | append: c | append: '_heading' -%}
        {%- assign heading = section.settings[hkey] -%}
        {%- if heading != blank -%}
          <div class="f-col">
            <h4>{{ heading | escape }}</h4>
            {%- for l in (1..6) -%}
              {%- assign lblkey = 'col_' | append: c | append: '_link_' | append: l | append: '_label' -%}
              {%- assign urlkey = 'col_' | append: c | append: '_link_' | append: l | append: '_url' -%}
              {%- assign lbl = section.settings[lblkey] -%}
              {%- assign lurl = section.settings[urlkey] -%}
              {%- if lbl != blank -%}<a href="{{ lurl }}">{{ lbl | escape }}</a>{%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  {%- if section.settings.watermark_word != blank -%}
  <div class="f-wordmark" id="f-watermark" aria-hidden="true">{{ section.settings.watermark_word | escape }}</div>
  {%- endif -%}
  <div class="f-center-logo">
    {%- if section.settings.center_logo != blank -%}
      <img src="{{ section.settings.center_logo | image_url: width: 600 }}" alt="{{ section.settings.brand_name | escape }}" loading="lazy" decoding="async">
    {%- else -%}
      <img src="{{ 'Logo.png' | asset_url }}" alt="{{ section.settings.brand_name | escape }}" loading="lazy" decoding="async">
    {%- endif -%}
  </div>
  <div class="f-bottom">
    <div class="f-legal">© {{ 'now' | date: '%Y' }} {{ section.settings.legal_text | escape | replace: '//', '<br>' }}</div>
  </div>
</footer>

