<!-- BOTTLES — selector + hero (Concept E) -->
<style>
  .bottles-section .ce-more-info{
    display:inline-flex; align-items:center; gap:.4rem;
    padding:1rem 2.4rem; border-radius:100px;
    font-size:.75rem; letter-spacing:.22em; text-transform:uppercase; font-weight:500;
    text-decoration:none;
    background:var(--smoke); color:var(--cream);
    transition:background .3s, transform .2s;
  }
  .bottles-section .ce-more-info:hover{
    background:var(--ink); color:var(--cream); transform:translateY(-1px);
  }
  .bottles-section .ce-visual-word{ bottom:2.5rem !important; }

  /* Harden the bottle visual so it renders correctly even if theme.css drifts.
     Kept here (not theme.css) so a theme.css paste can't clobber it. */
  .bottles-section .ce-main-shot{ overflow: hidden; }
  .bottles-section .ce-bottle-img{
    max-height: min(90vh, 600px);
    width: auto; max-width: 90%;
    object-fit: contain;
  }
  .bottles-section .ce-shots{
    position: absolute; left: 0; top: 0; bottom: 0; z-index: 3;
    display: flex; flex-direction: column; justify-content: center; gap: 10px;
    padding: 1.5rem 1rem; align-items: center;
  }
  .bottles-section .ce-shot-thumb{
    width: 62px; aspect-ratio: 3/4; flex: 0 0 auto;
    overflow: hidden; cursor: pointer;
    border: 2px solid rgba(26,23,22,.15);
    opacity: .5;
    display: flex; align-items: center; justify-content: center;
    transition: border-color .25s, opacity .25s;
  }
  .bottles-section .ce-shot-thumb.active{ opacity: 1; border-color: rgba(26,23,22,.45); }
  .bottles-section .ce-shot-thumb:hover{ opacity: .85; }
  .bottles-section .ce-shot-thumb img{ width: 100%; height: 100%; object-fit: cover; display: block; }

  /* Mobile: keep the bottle photo inside its visual slot so it can't overflow
     down into the copy. Kept here (not theme.css) so it can't be clobbered. */
  @media (max-width: 900px){
    .bottles-section .ce-visual{ overflow: hidden; }
    .bottles-section .ce-main-shot{ height: 100%; padding: 1rem; box-sizing: border-box; }
    .bottles-section .ce-bottle-img{
      max-height: 100% !important;
      max-width: 70% !important;
    }
  }
</style>
<section class="bottles-section" id="mezcals" data-nav="light" data-bg="bg-cream" data-mf-color="#F3E6D1"{% if section.settings.section_bg != blank %} style="background:{{ section.settings.section_bg }}"{% endif %}>
<div class="bottles-selector">
  <div class="ce-strip">
    <div class="ce-strip-head">
      <div class="label">{{ section.settings.strip_label | escape }}</div>
      <h2>{{ section.settings.strip_heading | escape }}</h2>
    </div>
    <div class="ce-items">
      {%- for block in section.blocks -%}
        <div class="ce-item{% if forloop.first %} active{% endif %}" data-e="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <div class="ce-thumb"><div class="ce-thumb-b" style="background:var(--{{ block.settings.accent }});height:{{ block.settings.thumb_height }}px"></div></div>
          <div class="ce-item-meta">
            <div class="ce-item-tag">{{ block.settings.species | escape }}</div>
            <div class="ce-item-name">{{ block.settings.name | escape }}</div>
            <div class="ce-item-price">{{ block.settings.price | escape }}</div>
          </div>
          <div class="ce-item-agave">
            {%- if block.settings.agave_image != blank -%}
              <img src="{{ block.settings.agave_image | image_url: width: 300 }}" alt="{{ block.settings.name | escape }} agave plant illustration" decoding="async" loading="lazy">
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
  <div class="ce-hero">
    {%- for block in section.blocks -%}
      <div class="ce-panel{% if forloop.first %} active{% endif %}">
        <div class="ce-visual">
          <div class="ce-visual-word">{{ block.settings.name | escape }}</div>
          <div class="ce-main-shot">
            {%- if block.settings.bottle_image != blank -%}
              <img class="ce-bottle-img" data-main-img src="{{ block.settings.bottle_image | image_url: width: 600 }}" alt="{{ block.settings.name | escape }} bottle" decoding="async">
            {%- else -%}
              <div class="b-shape" style="background:rgba(26,23,22,.2);width:88px;height:280px"></div>
            {%- endif -%}
          </div>
          <div class="ce-shots">
            {%- if block.settings.bottle_image != blank -%}
              <div class="ce-shot-thumb active" data-shot="{{ block.settings.bottle_image | image_url: width: 600 }}">
                <img src="{{ block.settings.bottle_image | image_url: width: 120 }}" alt="Front" loading="lazy" decoding="async">
              </div>
            {%- else -%}
              <div class="ce-shot-thumb active"><div class="ce-shot-label">Front</div></div>
            {%- endif -%}
            {%- if block.settings.shot_2_image != blank -%}
              <div class="ce-shot-thumb" data-shot="{{ block.settings.shot_2_image | image_url: width: 600 }}">
                <img src="{{ block.settings.shot_2_image | image_url: width: 120 }}" alt="Back" loading="lazy" decoding="async">
              </div>
            {%- else -%}
              <div class="ce-shot-thumb"><div class="ce-shot-label">Back</div></div>
            {%- endif -%}
            {%- if block.settings.shot_3_image != blank -%}
              <div class="ce-shot-thumb" data-shot="{{ block.settings.shot_3_image | image_url: width: 600 }}">
                <img src="{{ block.settings.shot_3_image | image_url: width: 120 }}" alt="Style" loading="lazy" decoding="async">
              </div>
            {%- else -%}
              <div class="ce-shot-thumb"><div class="ce-shot-label">Style</div></div>
            {%- endif -%}
          </div>
        </div>
        <div class="ce-divider"></div>
        <div class="ce-copy">
          <div class="label">{{ block.settings.copy_label | escape }}</div>
          <h3>{{ block.settings.name | escape }}</h3>
          <div class="ce-rev-head" style="font-size:1.2rem;margin-bottom:1rem">{{ block.settings.tier_name | escape | replace: '//', '<br>' }}</div>
          <ul class="ce-specs">
            {%- if block.settings.spec_1 != blank -%}<li>{{ block.settings.spec_1 | escape | replace: '//', '<br>' }}</li>{%- endif -%}
            {%- if block.settings.spec_2 != blank -%}<li>{{ block.settings.spec_2 | escape | replace: '//', '<br>' }}</li>{%- endif -%}
            {%- if block.settings.spec_3 != blank -%}<li>{{ block.settings.spec_3 | escape | replace: '//', '<br>' }}</li>{%- endif -%}
          </ul>
          <div class="ce-notes">
            {%- if block.settings.nose != blank -%}<p><b>Nose:</b> {{ block.settings.nose | escape | replace: '//', '<br>' }}</p>{%- endif -%}
            {%- if block.settings.palate != blank -%}<p><b>Palate:</b> {{ block.settings.palate | escape | replace: '//', '<br>' }}</p>{%- endif -%}
            {%- if block.settings.body != blank -%}<p><b>Body:</b> {{ block.settings.body | escape | replace: '//', '<br>' }}</p>{%- endif -%}
            {%- if block.settings.finish != blank -%}<p><b>Finish:</b> {{ block.settings.finish | escape | replace: '//', '<br>' }}</p>{%- endif -%}
          </div>
          <p class="ce-notes-body">{{ block.settings.desc_body | escape | replace: '//', '<br>' }}</p>
          <div class="ce-copy-buy">
            <span class="ce-copy-price">{{ block.settings.price | escape }}</span>
            <a class="mag-btn mag-dark" href="{{ block.settings.buy_url }}">{{ section.settings.buy_label | escape }}</a>
            {%- if block.settings.detail_url != blank -%}
              <a class="mag-btn ce-more-info" href="{{ block.settings.detail_url }}">Full Details &rarr;</a>
            {%- endif -%}
          </div>
          {%- if block.settings.review_quote != blank -%}
            <div class="ce-reviews">
              <div class="ce-rev-head">Customers Are Saying</div>
              <div class="ce-rev-meta">
                <span class="ce-stars">★★★★★</span>
                <span>{{ block.settings.review_rating | escape }} ★ ({{ block.settings.review_count | escape }})</span>
                <span class="ce-rev-verified"><svg viewBox="0 0 24 24"><path d="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>Verified</span>
              </div>
              <p class="ce-rev-quote">{{ block.settings.review_quote | escape | replace: '//', '<br>' }}</p>
              <div class="ce-rev-author">{{ block.settings.review_author | escape | replace: '//', '<br>' }}</div>
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>
</section>

<script>
(function(){
  document.querySelectorAll('.ce-panel').forEach(function(panel){
    panel.querySelectorAll('.ce-shot-thumb[data-shot]').forEach(function(thumb){
      thumb.addEventListener('click', function(){
        var main = panel.querySelector('[data-main-img]');
        if(!main) return;
        main.src = thumb.dataset.shot;
        panel.querySelectorAll('.ce-shot-thumb').forEach(function(t){ t.classList.remove('active'); });
        thumb.classList.add('active');
      });
    });
  });
})();
</script>

{% schema %}
{
  "name": "Bottle Selector",
  "settings": [
    { "type": "header", "content": "Section" },
    { "type": "color", "id": "section_bg", "label": "Background color", "info": "Leave empty to keep the scroll color blend into the manifesto." },
    { "type": "text", "id": "strip_label", "label": "Eyebrow label", "default": "Four Expressions · Ships to 40+ States" },
    { "type": "text", "id": "strip_heading", "label": "Heading", "default": "The Collection" },
    { "type": "text", "id": "buy_label", "label": "Buy button text", "default": "Add to Cart" }
  ],
  "blocks": [
    {
      "type": "expression",
      "name": "Expression",
      "settings": [
        { "type": "header", "content": "Identity" },
        { "type": "text", "id": "name", "label": "Name", "default": "Espadin" },
        { "type": "text", "id": "species", "label": "Agave species (short)", "default": "Angustifolia" },
        { "type": "text", "id": "copy_label", "label": "Copy eyebrow", "default": "100% Agave Angustifolia" },
        { "type": "text", "id": "price", "label": "Price", "default": "$64" },
        { "type": "url", "id": "buy_url", "label": "Buy / product link" },
        { "type": "url", "id": "detail_url", "label": "More Info link (product page)" },
        { "type": "select", "id": "accent", "label": "Accent colour", "default": "hibiscus",
          "options": [
            { "value": "hibiscus", "label": "Hibiscus" },
            { "value": "lake", "label": "Lake" },
            { "value": "copper", "label": "Copper" },
            { "value": "mustard", "label": "Mustard" },
            { "value": "solar", "label": "Solar" },
            { "value": "cactus", "label": "Cactus" },
            { "value": "rose", "label": "Rose" }
          ] },
        { "type": "range", "id": "thumb_height", "label": "Selector swatch height", "min": 30, "max": 60, "step": 1, "unit": "px", "default": 42 },
        { "type": "header", "content": "Images" },
        { "type": "image_picker", "id": "agave_image", "label": "Agave illustration (PNG)" },
        { "type": "image_picker", "id": "bottle_image", "label": "Bottle shot — Front (transparent PNG)" },
        { "type": "image_picker", "id": "shot_2_image", "label": "Bottle shot — Back (optional)" },
        { "type": "image_picker", "id": "shot_3_image", "label": "Bottle shot — Lifestyle / Style (optional)" },
        { "type": "header", "content": "Description (use // for line break)" },
        { "type": "text", "id": "tier_name", "label": "Tier name", "default": "The Gateway" },
        { "type": "text", "id": "spec_1", "label": "Spec 1", "default": "100% Agave Angustifolia" },
        { "type": "text", "id": "spec_2", "label": "Spec 2", "default": "6-8 Year Plant Maturation" },
        { "type": "text", "id": "spec_3", "label": "Spec 3", "default": "ABV: 46%" },
        { "type": "text", "id": "nose", "label": "Nose", "default": "Gentle smoke, aloe, honey, green olive" },
        { "type": "text", "id": "palate", "label": "Palate", "default": "Sichuan pepper, grapefruit peel, star fruit, miso, light smoke, citrus lift" },
        { "type": "text", "id": "body", "label": "Body", "default": "Medium bodied, balanced, approachable" },
        { "type": "text", "id": "finish", "label": "Finish", "default": "Clean, delicate" },
        { "type": "text", "id": "desc_body", "label": "Description paragraph", "default": "This expression captures a classic mezcal profile, balancing smoke, spice, acidity, and subtle sweetness." },
        { "type": "header", "content": "Pairing (use // for line break)" },
        { "type": "text", "id": "pair_cocktails", "label": "Cocktails", "default": "Mezcal Negroni, Oaxacan Old Fashioned, Paloma" },
        { "type": "text", "id": "pair_food", "label": "Food", "default": "Grilled citrus shrimp, queso fresco, charred corn, salsa verde" },
        { "type": "text", "id": "pair_body", "label": "Pairing paragraph", "default": "Its balanced smoke and bright acidity make Espadin the most versatile pour in the range." },
        { "type": "header", "content": "Highlights (use // for line break)" },
        { "type": "text", "id": "highlight_1", "label": "Highlight 1", "default": "Single-village production in the highlands of Oaxaca" },
        { "type": "text", "id": "highlight_2", "label": "Highlight 2", "default": "Earthen-pit roasted, tahona-crushed, copper distilled" },
        { "type": "text", "id": "highlight_3", "label": "Highlight 3", "default": "Small-batch — never more than 600 bottles per run" },
        { "type": "text", "id": "highlight_4", "label": "Highlight 4", "default": "The ideal introduction to artesanal mezcal" },
        { "type": "header", "content": "Review" },
        { "type": "text", "id": "review_rating", "label": "Rating", "default": "5.00" },
        { "type": "text", "id": "review_count", "label": "Review count", "default": "20" },
        { "type": "text", "id": "review_quote", "label": "Quote", "default": "“Probably the most complex mezcal I’ve ever tasted. Truly special.”" },
        { "type": "text", "id": "review_author", "label": "Author", "default": "— Verified Buyer" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Bottle Selector" }]
}
{% endschema %}
