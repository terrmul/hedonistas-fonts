<!-- PRODUCT DETAIL PAGE — matches bottle selector layout -->
<style>
nav,nav.nav-scrolled{
  mix-blend-mode:normal!important;
  background:rgba(243,230,209,.55)!important;
  backdrop-filter:blur(14px)!important;-webkit-backdrop-filter:blur(14px)!important;
  border-bottom:1px solid rgba(26,23,22,.12)!important;
}
nav .nav-wordmark,nav ul a{color:var(--ink)!important}
nav .nav-cart{border-color:rgba(26,23,22,.35)!important}
nav img.nav-icon{filter:brightness(0)!important}
.nav-hamburger span{background:var(--ink)!important}

/* Clear the fixed header above the bottle name + space beneath the ghost word */
#pdp.pdp-page{ padding-top:9rem !important; }
.pdp-page .ce-copy{ padding-top:1.5rem; }
.pdp-page .ce-visual-word{ bottom:2.5rem !important; }

/* Click-to-zoom affordance */
.pdp-page .ce-bottle-img{ cursor:zoom-in; }

/* The Collection back link — match the Full Details pill (lighter shade) */
.pdp-page .pdp-back{
  display:inline-flex; align-items:center; gap:.4rem;
  margin-top:2rem; align-self:flex-start;
  padding:1rem 2.4rem; border-radius:100px;
  font-size:.75rem; letter-spacing:.22em; text-transform:uppercase; font-weight:500;
  text-decoration:none;
  background:var(--smoke); color:var(--cream);
  transition:background .3s, transform .2s;
}
.pdp-page .pdp-back:hover{
  background:var(--ink); color:var(--cream); transform:translateY(-1px);
}

/* Click-to-zoom lightbox (shared markup id; hidden via [hidden] so it never
   covers the page or captures the cursor when closed) */
#ce-lightbox{
  position: fixed; inset: 0; z-index: 100050;
  display: flex; align-items: center; justify-content: center;
  background: rgba(26,23,22,.9);
  -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
  padding: 5vmin; cursor: zoom-out;
  opacity: 0; transition: opacity .25s ease;
}
#ce-lightbox[hidden]{ display: none !important; }
#ce-lightbox.open{ opacity: 1; }
#ce-lightbox img{
  max-width: 92vw; max-height: 92vh; object-fit: contain;
  cursor: default; border-radius: 8px;
  box-shadow: 0 30px 80px -20px rgba(0,0,0,.7);
}
#ce-lightbox .ce-lightbox-close{
  position: absolute; top: 1.1rem; right: 1.6rem;
  background: none; border: 0; color: var(--cream,#F3E6D1);
  font-size: 2.6rem; line-height: 1; cursor: pointer; padding: .2rem .4rem;
}
body.ce-zoom-open{ overflow: hidden; }

@media(max-width:767px){
  .pdp-page .bottles-selector{min-height:unset}
  .pdp-page .ce-hero{flex-direction:column}
  .pdp-page .ce-panel.active{flex-direction:column;min-height:unset}
  .pdp-page .ce-visual{flex:0 0 auto;width:100%;max-width:100%;padding-top:5rem}
  .pdp-page .ce-main-shot{display:flex;justify-content:center;align-items:center}
  .pdp-page .ce-bottle-img{max-height:55vw;width:auto;max-width:60vw;object-fit:contain}
  .pdp-page .ce-divider{display:none}
  .pdp-page .ce-copy{width:100%;padding:1.5rem 1.25rem 2rem}
  .pdp-page .ce-visual-word{font-size:clamp(3rem,18vw,7rem)}
  .pdp-page .ce-shots{justify-content:center;gap:.5rem;padding:.75rem 0}
}
</style>

<section class="bottles-section pdp-page" id="pdp" data-nav="light" data-bg="bg-cream"{% if section.settings.section_bg != blank %} style="background:{{ section.settings.section_bg }}"{% endif %}>
  <div class="bottles-selector">
    <div class="ce-hero">
      <div class="ce-panel active">

        <!-- LEFT: sticky bottle visual -->
        <div class="ce-visual">
          <div class="ce-visual-word">{{ section.settings.name | escape }}</div>
          <div class="ce-main-shot">
            {%- if section.settings.bottle_image != blank -%}
              <img class="ce-bottle-img" id="pdp-hero-img" src="{{ section.settings.bottle_image | image_url: width: 700 }}" data-zoom="{{ section.settings.bottle_image | image_url: width: 1600 }}" alt="{{ section.settings.name | escape }} bottle" decoding="async">
            {%- else -%}
              <div class="b-shape" style="background:rgba(26,23,22,.2);width:88px;height:280px"></div>
            {%- endif -%}
          </div>
          <div class="ce-shots">
            {%- if section.settings.bottle_image != blank -%}
              <div class="ce-shot-thumb active" data-shot="{{ section.settings.bottle_image | image_url: width: 700 }}" data-zoom="{{ section.settings.bottle_image | image_url: width: 1600 }}">
                <img src="{{ section.settings.bottle_image | image_url: width: 120 }}" alt="Front" loading="lazy" decoding="async">
              </div>
            {%- else -%}
              <div class="ce-shot-thumb active"><div class="ce-shot-label">Front</div></div>
            {%- endif -%}
            {%- if section.settings.shot_2_image != blank -%}
              <div class="ce-shot-thumb" data-shot="{{ section.settings.shot_2_image | image_url: width: 700 }}" data-zoom="{{ section.settings.shot_2_image | image_url: width: 1600 }}">
                <img src="{{ section.settings.shot_2_image | image_url: width: 120 }}" alt="Back" loading="lazy" decoding="async">
              </div>
            {%- else -%}
              <div class="ce-shot-thumb"><div class="ce-shot-label">Back</div></div>
            {%- endif -%}
            {%- if section.settings.shot_3_image != blank -%}
              <div class="ce-shot-thumb" data-shot="{{ section.settings.shot_3_image | image_url: width: 700 }}" data-zoom="{{ section.settings.shot_3_image | image_url: width: 1600 }}">
                <img src="{{ section.settings.shot_3_image | image_url: width: 120 }}" alt="Style" loading="lazy" decoding="async">
              </div>
            {%- else -%}
              <div class="ce-shot-thumb"><div class="ce-shot-label">Style</div></div>
            {%- endif -%}
          </div>
        </div>

        <div class="ce-divider"></div>

        <!-- RIGHT: copy -->
        <div class="ce-copy">
          <div class="label">{{ section.settings.copy_label | escape }}</div>
          <h1 class="pdp-h1">{{ section.settings.name | escape }}</h1>

          <div class="ce-tabs">
            <button class="ce-tab active" data-tab="desc">Description</button>
            <button class="ce-tab" data-tab="pair">Cocktail &amp; Food Pairing</button>
            <button class="ce-tab" data-tab="high">Highlights</button>
          </div>

          <div class="ce-tab-panel active" data-tab="desc">
            <div class="ce-rev-head" style="font-size:1.2rem;margin-bottom:1rem">{{ section.settings.tier_name | escape | replace: '//', '<br>' }}</div>
            <ul class="ce-specs">
              {%- if section.settings.spec_1 != blank -%}<li>{{ section.settings.spec_1 | escape | replace: '//', '<br>' }}</li>{%- endif -%}
              {%- if section.settings.spec_2 != blank -%}<li>{{ section.settings.spec_2 | escape | replace: '//', '<br>' }}</li>{%- endif -%}
              {%- if section.settings.spec_3 != blank -%}<li>{{ section.settings.spec_3 | escape | replace: '//', '<br>' }}</li>{%- endif -%}
            </ul>
            <div class="ce-notes">
              {%- if section.settings.nose != blank -%}<p><b>Nose:</b> {{ section.settings.nose | escape | replace: '//', '<br>' }}</p>{%- endif -%}
              {%- if section.settings.palate != blank -%}<p><b>Palate:</b> {{ section.settings.palate | escape | replace: '//', '<br>' }}</p>{%- endif -%}
              {%- if section.settings.body != blank -%}<p><b>Body:</b> {{ section.settings.body | escape | replace: '//', '<br>' }}</p>{%- endif -%}
              {%- if section.settings.finish != blank -%}<p><b>Finish:</b> {{ section.settings.finish | escape | replace: '//', '<br>' }}</p>{%- endif -%}
            </div>
            <p class="ce-notes-body">{{ section.settings.desc_body | escape | replace: '//', '<br>' }}</p>
          </div>

          <div class="ce-tab-panel" data-tab="pair">
            <div class="ce-notes">
              {%- if section.settings.pair_cocktails != blank -%}<p><b>Cocktails:</b> {{ section.settings.pair_cocktails | escape | replace: '//', '<br>' }}</p>{%- endif -%}
              {%- if section.settings.pair_food != blank -%}<p><b>Food:</b> {{ section.settings.pair_food | escape | replace: '//', '<br>' }}</p>{%- endif -%}
            </div>
            <p class="ce-notes-body">{{ section.settings.pair_body | escape | replace: '//', '<br>' }}</p>
          </div>

          <div class="ce-tab-panel" data-tab="high">
            <ul class="ce-highlights">
              {%- if section.settings.highlight_1 != blank -%}<li>{{ section.settings.highlight_1 | escape | replace: '//', '<br>' }}</li>{%- endif -%}
              {%- if section.settings.highlight_2 != blank -%}<li>{{ section.settings.highlight_2 | escape | replace: '//', '<br>' }}</li>{%- endif -%}
              {%- if section.settings.highlight_3 != blank -%}<li>{{ section.settings.highlight_3 | escape | replace: '//', '<br>' }}</li>{%- endif -%}
              {%- if section.settings.highlight_4 != blank -%}<li>{{ section.settings.highlight_4 | escape | replace: '//', '<br>' }}</li>{%- endif -%}
            </ul>
          </div>

          <div class="ce-copy-buy">
            <span class="ce-copy-price">{{ section.settings.price | escape }}</span>
            <form action="/cart/add" method="post" enctype="multipart/form-data" style="display:contents">
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <button type="submit" class="mag-btn mag-dark"{% unless product.available %} disabled{% endunless %}>
                {%- if product.available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}
              </button>
            </form>
          </div>

          {%- if section.settings.review_quote != blank -%}
            <div class="ce-reviews">
              <div class="ce-rev-head">Customers Are Saying</div>
              <div class="ce-rev-meta">
                <span class="ce-stars">★★★★★</span>
                <span>{{ section.settings.review_rating | escape }} ★ ({{ section.settings.review_count | escape }})</span>
                <span class="ce-rev-verified"><svg viewBox="0 0 24 24"><path d="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>Verified</span>
              </div>
              <p class="ce-rev-quote">{{ section.settings.review_quote | escape | replace: '//', '<br>' }}</p>
              <div class="ce-rev-author">{{ section.settings.review_author | escape | replace: '//', '<br>' }}</div>
            </div>
          {%- endif -%}

          <a class="mag-btn pdp-back" href="/#mezcals">&larr; The Collection</a>
        </div>

      </div>
    </div>
  </div>
</section>

<div id="ce-lightbox" aria-hidden="true" hidden>
  <button class="ce-lightbox-close" type="button" aria-label="Close">&times;</button>
  <img alt="">
</div>

<script>
(function(){
  var hero = document.getElementById('pdp-hero-img');

  /* lightbox */
  var lb = document.getElementById('ce-lightbox');
  var lbImg = lb ? lb.querySelector('img') : null;
  function openLB(src, alt){
    if(!lb || !lbImg || !src) return;
    lbImg.src = src; lbImg.alt = alt || '';
    lb.hidden = false;
    requestAnimationFrame(function(){ lb.classList.add('open'); });
    document.body.classList.add('ce-zoom-open');
  }
  function closeLB(){
    if(!lb) return;
    lb.classList.remove('open');
    document.body.classList.remove('ce-zoom-open');
    setTimeout(function(){ lb.hidden = true; if(lbImg) lbImg.src = ''; }, 250);
  }
  if(lb){
    lb.addEventListener('click', function(e){
      if(e.target === lb || e.target.closest('.ce-lightbox-close')) closeLB();
    });
    document.addEventListener('keydown', function(e){ if(e.key === 'Escape') closeLB(); });
  }

  /* thumbnails swap the main image (no zoom) */
  document.querySelectorAll('.pdp-page .ce-shot-thumb[data-shot]').forEach(function(thumb){
    thumb.addEventListener('click', function(){
      if(hero){
        hero.src = thumb.dataset.shot;
        if(thumb.dataset.zoom) hero.setAttribute('data-zoom', thumb.dataset.zoom);
      }
      document.querySelectorAll('.pdp-page .ce-shot-thumb').forEach(function(t){ t.classList.remove('active'); });
      thumb.classList.add('active');
    });
  });

  /* zoom opens only when the main image itself is clicked */
  if(hero){
    hero.addEventListener('click', function(){
      openLB(hero.getAttribute('data-zoom') || hero.src, hero.alt);
    });
  }

  /* tabs */
  document.querySelectorAll('.pdp-page .ce-tab').forEach(function(tab){
    tab.addEventListener('click', function(){
      var t = tab.dataset.tab;
      document.querySelectorAll('.pdp-page .ce-tab').forEach(function(x){ x.classList.remove('active'); });
      document.querySelectorAll('.pdp-page .ce-tab-panel').forEach(function(x){ x.classList.remove('active'); });
      tab.classList.add('active');
      var panel = document.querySelector('.pdp-page .ce-tab-panel[data-tab="'+t+'"]');
      if(panel) panel.classList.add('active');
    });
  });
})();
</script>

{% schema %}
{
  "name": "Product Page",
  "settings": [
    { "type": "header", "content": "Section" },
    { "type": "color", "id": "section_bg", "label": "Background color", "default": "#F3E6D1" },
    { "type": "header", "content": "Identity" },
    { "type": "text", "id": "name", "label": "Name", "default": "Espadín" },
    { "type": "text", "id": "species", "label": "Agave species", "default": "Angustifolia" },
    { "type": "text", "id": "copy_label", "label": "Eyebrow", "default": "100% Agave Angustifolia" },
    { "type": "text", "id": "price", "label": "Price", "default": "$64" },
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "bottle_image", "label": "Bottle — Front" },
    { "type": "image_picker", "id": "shot_2_image", "label": "Bottle — Back (optional)" },
    { "type": "image_picker", "id": "shot_3_image", "label": "Bottle — Lifestyle (optional)" },
    { "type": "header", "content": "Description tab (use // for line break)" },
    { "type": "text", "id": "tier_name", "label": "Tier name", "default": "The Gateway" },
    { "type": "text", "id": "spec_1", "label": "Spec 1" },
    { "type": "text", "id": "spec_2", "label": "Spec 2" },
    { "type": "text", "id": "spec_3", "label": "Spec 3" },
    { "type": "text", "id": "nose", "label": "Nose" },
    { "type": "text", "id": "palate", "label": "Palate" },
    { "type": "text", "id": "body", "label": "Body" },
    { "type": "text", "id": "finish", "label": "Finish" },
    { "type": "text", "id": "desc_body", "label": "Description paragraph" },
    { "type": "header", "content": "Pairing tab (use // for line break)" },
    { "type": "text", "id": "pair_cocktails", "label": "Cocktails" },
    { "type": "text", "id": "pair_food", "label": "Food" },
    { "type": "text", "id": "pair_body", "label": "Pairing paragraph" },
    { "type": "header", "content": "Highlights tab (use // for line break)" },
    { "type": "text", "id": "highlight_1", "label": "Highlight 1" },
    { "type": "text", "id": "highlight_2", "label": "Highlight 2" },
    { "type": "text", "id": "highlight_3", "label": "Highlight 3" },
    { "type": "text", "id": "highlight_4", "label": "Highlight 4" },
    { "type": "header", "content": "Review" },
    { "type": "text", "id": "review_rating", "label": "Rating", "default": "5.00" },
    { "type": "text", "id": "review_count", "label": "Review count", "default": "20" },
    { "type": "text", "id": "review_quote", "label": "Quote" },
    { "type": "text", "id": "review_author", "label": "Author", "default": "— Verified Buyer" }
  ],
  "presets": [{ "name": "Product Page" }]
}
{% endschema %}
