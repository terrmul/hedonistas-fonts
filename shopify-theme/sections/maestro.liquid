<!-- MAESTRO MEZCALERO -->
<style>
  /* Hide the 4px raspberry accent bar the theme draws at the top of this
     section. Kept here so a theme.css paste can't reintroduce it. */
  .maestro::before{ display: none !important; }
</style>
<section class="maestro" id="maestro" data-bg="bg-raspberry">
  {%- if section.settings.portrait != blank -%}
    <div class="maestro-portrait-bg" style="background-image:url('{{ section.settings.portrait | image_url: width: 1600 }}');background-size:cover;background-position:{{ section.settings.focus_x }}% {{ section.settings.focus_y }}%"></div>
  {%- else -%}
    <div class="maestro-portrait-bg"></div>
  {%- endif -%}
  <div class="maestro-scrim"></div>

  <div class="maestro-content">
    <div class="maestro-text">
      <div class="label">{{ section.settings.label | escape | replace: '//', '<br>' }}</div>
      <h2>{{ section.settings.heading | escape | replace: '//', '<br>' }}</h2>
      <div class="maestro-name">{{ section.settings.maestro_name | escape | replace: '//', '<br>' }}</div>
      {{ section.settings.body }}
    </div>
  </div>

  {%- if section.settings.portrait == blank -%}
    <div class="maestro-photo-note">📷 Full-bleed portrait — palenque, natural firelight, ~1600×2400px</div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Maestro",
  "settings": [
    { "type": "image_picker", "id": "portrait", "label": "Portrait (full-bleed, ~1600×2400)" },
    { "type": "range", "id": "focus_x", "label": "Image focus — horizontal", "info": "0 = left, 50 = center, 100 = right", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "focus_y", "label": "Image focus — vertical", "info": "0 = top, 50 = center, 100 = bottom", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "text", "id": "label", "label": "Eyebrow label (use // for line break)", "default": "El Maestro Mezcalero" },
    { "type": "text", "id": "heading", "label": "Heading (use // for line break)", "default": "The Hands Behind Every Drop." },
    { "type": "text", "id": "maestro_name", "label": "Maestro name (use // for line break)", "default": "[Maestro Name]" },
    { "type": "richtext", "id": "body", "label": "Body copy", "default": "<p>Third-generation mezcalero from the Sierra Juárez highlands, he learned the art of coaxing spirits from agave before he could read. His palenque sits at 1,800 metres — where the air is thin, the nights are cold, and the maguey grows slowly into something extraordinary.</p><p>He selects each plant by hand, reads the earth after rain, and still uses the same clay pot still his grandfather built. There is no recipe. There is only accumulated wisdom and an unhurried respect for the plant.</p>" }
  ],
  "presets": [{ "name": "Maestro" }]
}
{% endschema %}
