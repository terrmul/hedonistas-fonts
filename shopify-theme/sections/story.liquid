<!-- BRAND STORY -->
{%- assign f_eyebrow = '"metallophile-sp8", sans-serif' -%}
{%- if section.settings.eyebrow_font == 'display' -%}{%- assign f_eyebrow = "'Pacifico', serif" -%}{%- elsif section.settings.eyebrow_font == 'sans' -%}{%- assign f_eyebrow = '-apple-system, "Helvetica Neue", Arial, sans-serif' -%}{%- endif -%}
{%- assign f_heading = "'Pacifico', serif" -%}
{%- if section.settings.heading_font == 'metallophile' -%}{%- assign f_heading = '"metallophile-sp8", sans-serif' -%}{%- elsif section.settings.heading_font == 'sans' -%}{%- assign f_heading = '-apple-system, "Helvetica Neue", Arial, sans-serif' -%}{%- endif -%}
{%- assign f_intro = '"metallophile-sp8", sans-serif' -%}
{%- if section.settings.intro_font == 'display' -%}{%- assign f_intro = "'Pacifico', serif" -%}{%- elsif section.settings.intro_font == 'sans' -%}{%- assign f_intro = '-apple-system, "Helvetica Neue", Arial, sans-serif' -%}{%- endif -%}
{%- assign f_body = '"metallophile-sp8", sans-serif' -%}
{%- if section.settings.body_font == 'display' -%}{%- assign f_body = "'Pacifico', serif" -%}{%- elsif section.settings.body_font == 'sans' -%}{%- assign f_body = '-apple-system, "Helvetica Neue", Arial, sans-serif' -%}{%- endif -%}
{%- assign f_quote = '"metallophile-sp8", sans-serif' -%}
{%- if section.settings.quote_font == 'display' -%}{%- assign f_quote = "'Pacifico', serif" -%}{%- elsif section.settings.quote_font == 'sans' -%}{%- assign f_quote = '-apple-system, "Helvetica Neue", Arial, sans-serif' -%}{%- endif -%}
{%- assign quote_style = 'normal' -%}
{%- if section.settings.quote_italic -%}{%- assign quote_style = 'italic' -%}{%- endif -%}

<section class="brand-story brand-story--solo reveal-section" id="story" data-nav="light" data-bg="bg-cream"
  data-overlay="{{ section.settings.overlay_color | default: '#9C8769' }}">

  <div class="bss-wrap">

    <header class="bss-head reveal">
      <div class="label bss-eyebrow" style="font-family:{{ f_eyebrow }};font-size:clamp(.6rem,1.5vw,{{ section.settings.eyebrow_size }}rem)">{{ section.settings.story_label | escape | replace: '//', '<br>' }}</div>
      <h2 class="bss-heading" style="font-family:{{ f_heading }};font-size:clamp(1.6rem,6vw,{{ section.settings.heading_size }}rem)">{{ section.settings.story_heading | escape | replace: '//', '<br>' }}</h2>
      {%- if section.settings.intro != blank -%}
        <p class="bss-intro" style="font-family:{{ f_intro }};font-size:clamp(1rem,2.2vw,{{ section.settings.intro_size }}rem)">{{ section.settings.intro | escape | replace: '//', '<br>' }}</p>
      {%- endif -%}
    </header>

    <div class="bss-grid">

      <div class="bss-media-col">
        {%- if section.settings.story_image != blank -%}
          <figure class="bss-figure reveal">
            <img class="bss-photo" src="{{ section.settings.story_image | image_url: width: 1400 }}"
              alt="{{ section.settings.story_image.alt | escape }}"
              style="object-position:{{ section.settings.image_x }}% {{ section.settings.image_y }}%"
              decoding="async" loading="lazy" onerror="this.closest('.bss-figure').remove()">
          </figure>
        {%- else -%}
          <div class="bss-figure bss-figure--ph reveal"><span class="ph-label">📷 Founders — candid, Oaxaca</span></div>
        {%- endif -%}
        {%- if section.settings.quote != blank -%}
          <blockquote class="bss-quote reveal" style="font-family:{{ f_quote }};font-size:clamp(1rem,1.9vw,{{ section.settings.quote_size }}rem);font-style:{{ quote_style }}">{{ section.settings.quote | escape | replace: '//', '<br>' }}</blockquote>
        {%- endif -%}
      </div>

      <div class="bss-text-col reveal">
        <div class="bss-body" style="font-family:{{ f_body }};font-size:clamp(1rem,1.6vw,{{ section.settings.body_size }}rem)">{{ section.settings.story_body | replace: '//', '<br>' }}</div>
      </div>

    </div>
  </div>
</section>

{% style %}
  /* transparent so the scroll-colour overlay shows through (no split, no gradient).
     overflow must stay visible on every ancestor or position:sticky won't engage. */
  #story.brand-story--solo{
    background: transparent !important;
    padding: clamp(4rem, 10vw, 9rem) 1.5rem;
    overflow: visible !important;
  }
  #story .bss-wrap{
    max-width: 1180px;
    margin-inline: auto;
    overflow: visible !important;
  }

  /* heading block */
  #story .bss-head{ text-align: center; margin: 0 auto clamp(2.5rem, 6vw, 4.5rem); max-width: 720px; }
  #story .bss-eyebrow{ color: var(--rust, #7C3A09); margin-bottom: 1rem; }
  #story .bss-heading{ line-height: 1.02; margin: 0 0 1.2rem; }
  #story .bss-intro{ line-height: 1.5; max-width: 46ch; margin: 0 auto; opacity: .82; }

  /* two-column: sticky image | scrolling text */
  #story .bss-grid{
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: clamp(2rem, 5vw, 5.5rem);
    align-items: start;
    overflow: visible !important;
  }
  #story .bss-media-col{
    position: sticky;
    top: clamp(5rem, 9vh, 7.5rem);
    align-self: start;
  }
  #story .bss-figure{
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    /* keep the whole sticky column shorter than the viewport so it actually pins */
    max-height: calc(100vh - 15rem);
    margin: 0;
  }
  #story .bss-figure--ph{ display:flex; align-items:center; justify-content:center; background:rgba(0,0,0,.18); }
  #story .bss-figure--ph .ph-label{ opacity:.7; font-size:.9rem; }
  #story .bss-photo{ width: 100%; height: 100%; object-fit: cover; display: block; }

  #story .bss-quote{
    margin: 1.6rem 0 0;
    line-height: 1.35;
    color: var(--rust, #7C3A09);
    border: 0;
    padding-left: 1.1rem;
    border-left: 3px solid var(--rust, #7C3A09);
  }

  #story .bss-text-col{ padding-top: .4rem; }
  #story .bss-body{ line-height: 1.8; }
  #story .bss-body p{ margin: 0 0 1.5em; }
  #story .bss-body p:first-child{ font-size: 1.18em; line-height: 1.55; }
  #story .bss-body p:first-child:first-letter{
    float: left; font-family: 'Pacifico', serif; font-size: 3.4em; line-height: .82; padding: .04em .12em 0 0;
    color: var(--rust, #7C3A09); font-weight: 400;
  }
  #story .bss-body p:last-child{ margin-bottom: 0; }

  /* mobile: stack, image first, no sticky */
  @media (max-width: 900px){
    #story .bss-grid{ grid-template-columns: 1fr; gap: 2.25rem; }
    #story .bss-media-col{ position: static; top: auto; }
    #story .bss-figure{ aspect-ratio: 16 / 10; max-height: none; }
    #story .bss-quote{ margin-top: 1.25rem; }
  }

  /* fade-in */
  #story .reveal{ opacity: 0; transform: translateY(24px); transition: opacity .8s ease, transform .8s ease; }
  #story .reveal.on{ opacity: 1; transform: none; }
{% endstyle %}

<script>
(function(){
  var els = document.querySelectorAll('#story .reveal');
  if(!els.length) return;
  if(!('IntersectionObserver' in window)){ els.forEach(function(e){ e.classList.add('on'); }); return; }
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('on'); io.unobserve(e.target); } });
  }, { threshold: 0.12 });
  els.forEach(function(e){ io.observe(e); });
})();
</script>

{% schema %}
{
  "name": "Brand Story",
  "settings": [
    { "type": "color", "id": "overlay_color", "label": "Section background color", "info": "Scroll-blend color for this section. Leave empty for #9C8769." },

    { "type": "header", "content": "Eyebrow (use // for a line break)" },
    { "type": "text", "id": "story_label", "label": "Eyebrow label", "default": "Nuestra Historia" },
    { "type": "select", "id": "eyebrow_font", "label": "Eyebrow font", "options": [ { "value": "metallophile", "label": "Metallophile (brand sans)" }, { "value": "display", "label": "Pacifico (display)" }, { "value": "sans", "label": "Sans (system)" } ], "default": "metallophile" },
    { "type": "range", "id": "eyebrow_size", "label": "Eyebrow size", "min": 0.6, "max": 2, "step": 0.1, "unit": "rem", "default": 0.8 },

    { "type": "header", "content": "Heading (use // for a line break)" },
    { "type": "text", "id": "story_heading", "label": "Heading", "default": "Born from Obsession." },
    { "type": "select", "id": "heading_font", "label": "Heading font", "options": [ { "value": "display", "label": "Pacifico (display)" }, { "value": "metallophile", "label": "Metallophile (brand sans)" }, { "value": "sans", "label": "Sans (system)" } ], "default": "display" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 1.5, "max": 7, "step": 0.5, "unit": "rem", "default": 4.5 },

    { "type": "header", "content": "Intro line (use // for a line break)" },
    { "type": "text", "id": "intro", "label": "Intro line (optional)" },
    { "type": "select", "id": "intro_font", "label": "Intro font", "options": [ { "value": "metallophile", "label": "Metallophile (brand sans)" }, { "value": "display", "label": "Pacifico (display)" }, { "value": "sans", "label": "Sans (system)" } ], "default": "metallophile" },
    { "type": "range", "id": "intro_size", "label": "Intro size", "min": 0.9, "max": 3, "step": 0.1, "unit": "rem", "default": 1.4 },

    { "type": "header", "content": "Story copy (use // for a line break)" },
    { "type": "richtext", "id": "story_body", "label": "Story copy", "default": "<p>Hedonistas Mezcal began with two friends and a stubborn belief — that the finest mezcal in the world deserves to be shared. Not hoarded. Not gatekept. Shared.</p><p>Founded in the highlands of Oaxaca, we partnered with maestros mezcaleros whose families have cultivated and cooked agave the same way for generations. No shortcuts. No industrial process. Just fire, stone, time, and copper — and a friendship that wouldn't settle for less.</p>" },
    { "type": "select", "id": "body_font", "label": "Body font", "options": [ { "value": "metallophile", "label": "Metallophile (brand sans)" }, { "value": "display", "label": "Pacifico (display)" }, { "value": "sans", "label": "Sans (system)" } ], "default": "metallophile" },
    { "type": "range", "id": "body_size", "label": "Body size", "min": 0.9, "max": 2, "step": 0.1, "unit": "rem", "default": 1.3 },

    { "type": "header", "content": "Pull quote (use // for a line break)" },
    { "type": "text", "id": "quote", "label": "Pull quote (optional)", "default": "\"The agave gives you everything. Your job is to not get in the way.\"" },
    { "type": "select", "id": "quote_font", "label": "Quote font", "options": [ { "value": "metallophile", "label": "Metallophile (brand sans)" }, { "value": "display", "label": "Pacifico (display)" }, { "value": "sans", "label": "Sans (system)" } ], "default": "metallophile" },
    { "type": "range", "id": "quote_size", "label": "Quote size", "min": 1, "max": 4, "step": 0.1, "unit": "rem", "default": 1.4 },
    { "type": "checkbox", "id": "quote_italic", "label": "Italicize quote", "default": false },

    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "story_image", "label": "Image — founders, candid (1200×1500 portrait works best)" },
    { "type": "range", "id": "image_x", "label": "Image focus — horizontal", "info": "50 = center", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "image_y", "label": "Image focus — vertical", "info": "50 = center", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 }
  ],
  "presets": [{ "name": "Brand Story" }]
}
{% endschema %}
