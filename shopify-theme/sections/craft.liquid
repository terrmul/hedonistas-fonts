<!-- STICKY CRAFT PANELS -->
<div class="sticky-chapter" id="craft">
  <div class="sticky-word" id="sticky-word"><h2>{%- if section.blocks.size > 0 -%}{{ section.blocks.first.settings.word | escape }}{%- endif -%}</h2></div>
  <div class="sticky-panels">
    {%- for block in section.blocks -%}
      <div class="s-panel" data-bg="{{ block.settings.bg }}" data-word="{{ block.settings.word | escape }}" {{ block.shopify_attributes }}>
        <div class="s-panel-content reveal">
          <div class="panel-img" style="width:calc({{ block.settings.img_width }}% - 6rem);height:{{ block.settings.img_height }}px;max-height:none">
            {%- if block.settings.image != blank -%}
              <img class="craft-img" src="{{ block.settings.image | image_url: width: 1400 }}" alt="{{ block.settings.image.alt | escape }}" decoding="async" loading="lazy" onerror="this.remove()">
            {%- else -%}
              <div class="pi-note">📷 {{ block.settings.word | escape }}</div>
            {%- endif -%}
          </div>
          <div class="num" style="color:var(--solar)">{{ block.settings.num | escape }}</div>
          <h3 style="color:var(--cream)">{{ block.settings.title | escape | replace: '//', '<br>' }}</h3>
          {%- if block.settings.subtitle != blank -%}
            <div style="color:var(--solar);font-size:.75rem;letter-spacing:.24em;text-transform:uppercase;font-weight:500;margin-bottom:1rem">{{ block.settings.subtitle | escape | replace: '//', '<br>' }}</div>
          {%- endif -%}
          <p style="color:rgba(243,230,209,.9)">{{ block.settings.body | replace: '//', '<br>' }}</p>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% style %}
  /* Desktop: the watermark word swaps per chapter (driven by JS). Long words
     (e.g. "La Fermentación") cannot fit the narrow lane right of the image, so
     keep the word LEFT-ALIGNED at the far left, sized to fit the full screen
     width, and layer it ABOVE the panels so the left-column image no longer
     clips it. The max size is set in the Customizer (Watermark size). Images
     stay full size; scroll timing and the data-bg colour blending are untouched. */
  @media (min-width: 1201px){
    #craft .sticky-word{
      z-index: 3 !important;          /* above .sticky-panels (images + text) */
      justify-content: flex-start !important;
      padding-left: 3rem !important;
      padding-right: 1.5rem !important;
      pointer-events: none;
    }
    #craft .sticky-word h2{
      font-size: clamp(3rem, 7.5vw, {{ section.settings.wm_size }}rem) !important;
      text-align: left;
      white-space: nowrap;
    }
  }

  /* Mobile + landscape phones: turn off the desktop sticky-scroll mechanic and
     lay each chapter out as a simple vertical block — image on top, text below.
     The decorative watermark is hidden here (no room for it without overlap). */
  @media (max-width: 1200px){
    #craft .sticky-word{ display: none !important; }
  }
  @media (max-width: 1024px){
    #craft{ overflow-x: hidden; }
    #craft .sticky-panels{ margin-top: 0 !important; }
    #craft .s-panel{
      min-height: 0 !important;
      display: block !important;
      width: 100% !important;
      padding: 3rem 1.5rem !important;
      box-sizing: border-box !important;
    }
    #craft .s-panel-content{
      display: block !important;
      width: 100% !important;
      max-width: 100% !important;
    }
    /* keep position:relative so the absolutely-positioned .craft-img stays
       inside this image box instead of expanding to cover the whole panel.
       Portrait ratio so the image is taller than it is wide. */
    #craft .panel-img{
      position: relative !important;
      transform: none !important;
      display: block !important;
      width: 100% !important;
      height: auto !important;
      aspect-ratio: 4 / 5 !important;
      max-height: 75vh !important;
      margin: 0 auto 1.6rem !important;
      overflow: hidden !important;
    }
    /* the reveal-on-scroll fade can leave text invisible when stacked —
       force everything visible so the chapter always shows on mobile */
    #craft .s-panel-content.reveal > *{
      opacity: 1 !important;
      transform: none !important;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Craft Chapters",
  "settings": [
    { "type": "header", "content": "Background watermark" },
    { "type": "paragraph", "content": "The big faded word behind each chapter is that chapter's “Watermark word” below. Use the slider to size it so long words still fit." },
    { "type": "range", "id": "wm_size", "label": "Watermark size", "info": "Max size on wide screens. Lower this if a long word runs off the edge.", "min": 3, "max": 14, "step": 0.5, "unit": "rem", "default": 8 }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "Chapter",
      "settings": [
        { "type": "select", "id": "bg", "label": "Background colour", "default": "bg-marine",
          "options": [
            { "value": "bg-marine", "label": "Marine" },
            { "value": "bg-rust", "label": "Rust" },
            { "value": "bg-raspberry", "label": "Raspberry" },
            { "value": "bg-umber", "label": "Umber" },
            { "value": "bg-cactus", "label": "Cactus" },
            { "value": "bg-copper", "label": "Copper" },
            { "value": "bg-smoke", "label": "Smoke" }
          ] },
        { "type": "text", "id": "num", "label": "Number", "default": "01" },
        { "type": "text", "id": "word", "label": "Watermark word (big faded background word)", "default": "La Tierra" },
        { "type": "text", "id": "title", "label": "Title (use // for a line break)", "default": "Wild Harvest" },
        { "type": "text", "id": "subtitle", "label": "Subtitle (use // for a line break)" },
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "range", "id": "img_width", "label": "Image width", "info": "% of panel — keep at/under 50 so it doesn't overlap the text (desktop only)", "min": 30, "max": 50, "step": 1, "unit": "%", "default": 46 },
        { "type": "range", "id": "img_height", "label": "Image height", "info": "Desktop only — mobile uses a responsive portrait height", "min": 200, "max": 1000, "step": 20, "unit": "px", "default": 500 },
        { "type": "inline_richtext", "id": "body", "label": "Body copy (use // for a line break)" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Craft Chapters" }]
}
{% endschema %}
